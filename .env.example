# ─────────────────────────────────────────────────────────────
# 🅟🅐🅝🅣🅗🅔🅞🅝 — environment configuration
# Copy to .env for local development. Keep secrets out of Git.
# ─────────────────────────────────────────────────────────────

# Server
PORT=3000
HOST=0.0.0.0

# Dashboard / API auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# ADMIN_TOKEN=

# Bot identity
BOT_NAME="🅟🅐🅝🅣🅗🅔🅞🅝"
OWNER_NAME="EMC 💀"
# OWNER_NUMBER=234xxxxxxxxxx
BOT_PREFIX=/
BOT_VERSION=1.2.0
BOT_TIMEZONE=Africa/Lagos
DEFAULT_COUNTRY_CODE=234

# Durable Supabase/Postgres storage. On Render free tier this is strongly
# recommended so Baileys creds + Signal/session keys survive redeploys.
# Use your Supabase Postgres connection string; do not commit the real URL.
# DATABASE_URL=postgresql://postgres.<project>:<password>@<pooler-host>:5432/postgres
DATABASE_POOL_MAX=5
# DATABASE_SSL=true
WA_SESSION_ID=pantheon-main

# WhatsApp session
SESSION_DIR=./data/session
FORCE_LOGOUT=0
# Optional WhatsApp WebSocket proxy
# PROXY_URL=socks5h://user:pass@host:1080
# BAILEYS_WA_VERSION=2.3000.1043857760

# Media / yt-dlp
MAX_CONCURRENT_DOWNLOADS=2
DEFAULT_QUALITY=720
MAX_FILE_SIZE_MB=1900
CLEANUP_AFTER_MINUTES=120
MEDIA_DIR=./data/media
DATA_DIR=./data

# If YouTube challenges Render with "Sign in to confirm you're not a bot",
# configure ONE of these. YTDLP_COOKIES_B64 is a base64-encoded Netscape
# cookies.txt file. Treat it like a password/secret.
# YTDLP_COOKIES_B64=
# YTDLP_COOKIES_FILE=/secure/path/cookies.txt
# YTDLP_PROXY_URL=http://user:pass@host:port

# Group AI (optional). /ai on stays quiet unless directly addressed.
# GROQ_API_KEY=
# AI_MODEL=llama-3.1-8b-instant
AI_COOLDOWN_MS=12000
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=300
AI_MAX_REPLY_CHARS=1200

# Optional private-chat allow-list. Groups are still handled normally.
# ALLOWED_CHATS=234xxxxxxxxxx,234yyyyyyyyyy

# Webhook
# WEBHOOK_URL=https://example.com/hooks/pantheon
# WEBHOOK_SECRET=change-me
WEBHOOK_ENABLED=false
# WEBHOOK_EVENTS=command,download.started,download.completed,download.failed,session.connected,session.disconnected,bot.ready

KEEPALIVE_INTERVAL_SEC=300
