# ─────────────────────────────────────────────────────────────
# WhatsApp Media Bot — environment configuration
# Copy to .env and adjust. Everything has a safe default.
# ─────────────────────────────────────────────────────────────

# Server
PORT=3000
HOST=0.0.0.0

# Dashboard / API auth (change these!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=wa-bot-admin
# Optional: static token for API/webhook automation (bypasses login)
# ADMIN_TOKEN=

# WhatsApp bot
# BOT_NAME appears as the browser/session name WhatsApp shows
BOT_NAME="WhatsApp Media Bot"
# Maximum concurrent media downloads (yt-dlp) at the same time
MAX_CONCURRENT_DOWNLOADS=2
# Default quality: 240 | 360 | 720 | 1080 (HD) | 2160 (4K) | 4320 (8K) | auto
DEFAULT_QUALITY=720
# Maximum file size in MB a single download may reach (WhatsApp doc limit ~2000MB)
MAX_FILE_SIZE_MB=1900
# Auto-clean downloaded media older than N minutes (0 = never clean)
CLEANUP_AFTER_MINUTES=120
# Force clean start: delete saved WhatsApp session on boot (1/0)
FORCE_LOGOUT=0

# Webhook (dashboard Settings > Webhook, or preset here)
# WEBHOOK_URL=https://example.com/hooks/whatsapp-bot
# WEBHOOK_SECRET=change-me
# WEBHOOK_ENABLED=true
# Comma separated event list: command,download.started,download.completed,download.failed,session.connected,session.disconnected,bot.ready
# WEBHOOK_EVENTS=command,download.started,download.completed,download.failed,session.connected,session.disconnected,bot.ready

# Paths
DATA_DIR=./data
SESSION_DIR=./data/session
MEDIA_DIR=./data/media

# Keep alive: self-ping health endpoint every N seconds (helps some hosts keep the process alive)
KEEPALIVE_INTERVAL_SEC=300
